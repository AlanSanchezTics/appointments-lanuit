{
  "name": "appointments-lanuit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --maxWorkers=1 tests/integration",
    "test:integration:file": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "locks:cleanup": "node --env-file=.env scripts/cleanup-reservation-locks.mjs",
    "months:reconcile": "node --env-file=.env scripts/reconcile-active-months.mjs",
    "calendar:smoke": "node --env-file=.env scripts/google-calendar-smoke.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:resolve:applied": "prisma migrate resolve --applied",
    "prisma:resolve:rolledback": "prisma migrate resolve --rolled-back",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "googleapis": "^144.0.0",
    "i18next": "^25.8.18",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "jsdom": "^26.0.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
