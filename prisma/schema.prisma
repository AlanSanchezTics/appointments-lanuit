generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  SYNC_FAILED
  PENDING
  REJECTED
}

enum AppointmentLogActionType {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  MODIFIED
}

enum AppointmentLogActorType {
  SYSTEM
  ADMIN
  CLIENT
}

enum ActiveMonthStatus {
  ACTIVE
  INACTIVE
}

enum MonthSlotMode {
  BLOCK_MODE
  SECOND_ONLY_MODE
}

enum AdminUserStatus {
  active
  inactive
}

enum BlockedSlotReason {
  DESCANSO
  PERSONAL
  OTRO
}

enum BlockedSlotCalendarSyncStatus {
  CONFIRMED
  SYNC_FAILED
}

enum BlockedSlotCalendarSyncReason {
  CALENDAR_NOT_CONFIGURED
  CALENDAR_SYNC_FAILED
  CALENDAR_DELETE_FAILED
}

model Appointment {
  id                   Int                   @id @default(autoincrement())
  clientId             Int                   @map("client_id")
  date                 DateTime              @db.Date
  timeSlot             DateTime              @map("time_slot") @db.Time(0)
  status               AppointmentStatus     @default(CONFIRMED)
  googleEventId        String?               @map("google_event_id") @db.VarChar(255)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  client               Client                @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  appointmentLogs      AppointmentLog[]

  @@index([date, timeSlot])
  @@index([clientId, status])
  @@index([date])
  @@map("appointments")
}

model AppointmentLog {
  id            Int                      @id @default(autoincrement())
  appointmentId Int                      @map("appointment_id")
  actionType    AppointmentLogActionType @map("action_type")
  payload       Json
  actorType     AppointmentLogActorType  @map("actor_type")
  clientId      Int                      @map("client_id")
  createdAt     DateTime                 @default(now()) @map("created_at")
  appointment   Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client        Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt])
  @@index([actionType, createdAt])
  @@index([actorType])
  @@index([clientId])
  @@index([appointmentId])
  @@map("appointment_logs")
}

model Client {
  id           Int           @id @default(autoincrement())
  clientNumber Int           @unique @map("client_number")
  name         String        @db.VarChar(100)
  alias        String?       @db.VarChar(100)
  phone        String        @unique @db.VarChar(10)
  isLoyal      Boolean       @default(false) @map("is_loyal")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  appointments Appointment[]
  appointmentLogs AppointmentLog[]

  @@map("clients")
}

model ReservationLock {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  timeSlot  DateTime @map("time_slot") @db.Time(0)
  phone     String   @db.VarChar(10)
  lockToken String   @unique @map("lock_token") @db.VarChar(191)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date, timeSlot, expiresAt])
  @@index([phone, expiresAt])
  @@map("reservation_locks")
}

model ActiveMonth {
  id                  Int                      @id @default(autoincrement())
  month               String                   @unique @db.Char(7)
  status              ActiveMonthStatus        @default(ACTIVE)
  slotMode            MonthSlotMode            @default(BLOCK_MODE) @map("slot_mode")
  availabilityVersion Int                      @default(0) @map("availability_version")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]

  @@index([status, month])
  @@map("active_months")
}

model AvailabilityRule {
  id               Int                       @id @default(autoincrement())
  activeMonthId    Int                       @map("active_month_id")
  startDate        DateTime                  @map("start_date") @db.Date
  endDate          DateTime                  @map("end_date") @db.Date
  minGapMinutes    Int                       @default(240) @map("min_gap_minutes") @db.SmallInt
  preserveCapacity Boolean                   @default(true) @map("preserve_capacity")
  maxPerDay        Int                       @default(3) @map("max_per_day") @db.TinyInt
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  activeMonth      ActiveMonth               @relation(fields: [activeMonthId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  weekdays         AvailabilityRuleWeekday[]
  times            AvailabilityRuleTime[]

  @@index([activeMonthId])
  @@map("availability_rules")
}

model AvailabilityRuleWeekday {
  ruleId  Int              @map("rule_id")
  weekday Int              @db.TinyInt
  rule    AvailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([ruleId, weekday])
  @@map("availability_rule_weekdays")
}

model AvailabilityRuleTime {
  ruleId   Int              @map("rule_id")
  timeSlot DateTime         @map("time_slot") @db.Time(0)
  rule     AvailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([ruleId, timeSlot])
  @@map("availability_rule_times")
}

model AvailabilityException {
  id               Int                         @id @default(autoincrement())
  activeMonthId    Int                         @map("active_month_id")
  date             DateTime                    @db.Date
  minGapMinutes    Int                         @default(240) @map("min_gap_minutes") @db.SmallInt
  preserveCapacity Boolean                     @default(true) @map("preserve_capacity")
  maxPerDay        Int                         @default(3) @map("max_per_day") @db.TinyInt
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  activeMonth      ActiveMonth                 @relation(fields: [activeMonthId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  times            AvailabilityExceptionTime[]

  @@unique([activeMonthId, date])
  @@map("availability_exceptions")
}

model AvailabilityExceptionTime {
  exceptionId Int                   @map("exception_id")
  timeSlot    DateTime              @map("time_slot") @db.Time(0)
  exception   AvailabilityException @relation(fields: [exceptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([exceptionId, timeSlot])
  @@map("availability_exception_times")
}

model AvailabilityMigrationRun {
  name        String   @id @db.VarChar(100)
  appliedAt   DateTime @map("applied_at")
  rowsCreated Int      @map("rows_created")

  @@map("availability_migration_runs")
}

model AdminUser {
  id                       Int                   @id @default(autoincrement())
  username                 String                @unique @db.VarChar(191)
  name                     String                @db.VarChar(100)
  passwordHash             String                @map("password_hash") @db.Char(64)
  passwordSalt             String                @map("password_salt") @db.VarChar(191)
  status                   AdminUserStatus       @default(active)
  lastLoginAt              DateTime?             @map("last_login_at")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  blockedSlots             BlockedSlot[]

  @@index([status])
  @@map("admin_users")
}

model BlockedSlot {
  id                 Int                           @id @default(autoincrement())
  date               DateTime                      @db.Date
  timeSlot           DateTime                      @map("time_slot") @db.Time(0)
  reason             BlockedSlotReason
  googleEventId      String?                       @map("google_event_id") @db.VarChar(255)
  calendarSyncStatus BlockedSlotCalendarSyncStatus @default(CONFIRMED) @map("calendar_sync_status")
  calendarSyncReason BlockedSlotCalendarSyncReason? @map("calendar_sync_reason")
  createdByAdminId   Int?                          @map("created_by_admin_user_id")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")
  createdByAdmin     AdminUser?                    @relation(fields: [createdByAdminId], references: [id])

  @@unique([date, timeSlot])
  @@index([date])
  @@index([calendarSyncStatus])
  @@index([createdByAdminId])
  @@map("blocked_slots")
}
