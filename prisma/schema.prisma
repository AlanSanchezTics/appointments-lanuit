generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  SYNC_FAILED
}

enum ActiveMonthStatus {
  ACTIVE
  INACTIVE
}

model Appointment {
  id            Int               @id @default(autoincrement())
  clientId      Int               @map("client_id")
  date          DateTime          @db.Date
  timeSlot      DateTime          @map("time_slot") @db.Time(0)
  status        AppointmentStatus @default(CONFIRMED)
  googleEventId String?           @map("google_event_id") @db.VarChar(255)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  client        Client            @relation(fields: [clientId], references: [id])

  @@index([date, timeSlot])
  @@index([clientId, status])
  @@index([date])
  @@map("appointments")
}

model Client {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  phone        String        @unique @db.VarChar(10)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  appointments Appointment[]

  @@map("clients")
}

model ReservationLock {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  timeSlot  DateTime @map("time_slot") @db.Time(0)
  phone     String   @db.VarChar(10)
  lockToken String   @unique @map("lock_token") @db.VarChar(191)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date, timeSlot, expiresAt])
  @@index([phone, expiresAt])
  @@map("reservation_locks")
}

model ActiveMonth {
  id        Int               @id @default(autoincrement())
  month     String            @unique @db.Char(7)
  status    ActiveMonthStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([status, month])
  @@map("active_months")
}
